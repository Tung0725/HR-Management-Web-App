<%-- any content can be specified here e.g.: --%>


<%@ page pageEncoding="UTF-8" %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet"> 


<style>

    /* 1. STICKY FOOTER */
    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background: linear-gradient(135deg, #40E0D0 0%, #20B2AA 100%);
        color: #fff;
    }
    main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* 2. HIỆU ỨNG */
    @keyframes zoomInUp {
        from {
            opacity: 0;
            transform: scale3d(0.3, 0.3, 0.3) translate3d(0, 100px, 0);
        }
        50% {
            opacity: 1;
        }
    }
    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.2);
        animation: zoomInUp 1s ease-out;
    }
    .hero-desc {
        font-size: 1.2rem;
        max-width: 700px;
        margin: 0 auto;
        opacity: 0.9;
        animation: zoomInUp 1s ease-out 0.3s backwards;
    }
    .fly-up-anim {
        animation: zoomInUp 1s ease-out 0.3s backwards;
    }
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: none;
        border-radius: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: zoomInUp 1s ease-out 0.6s backwards;
    }
    .glass-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }

    /* Nút nổi */
    .btn-float {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        z-index: 1000;
    }


    /* Làm cho form nổi bật trên nền xanh */
    .main-card {
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        padding: 30px;
        margin-top: 20px;
        margin-bottom: 20px;
    }
    /* Chỉ áp dụng hiệu ứng hover trên màn hình máy tính (thường là từ 992px trở lên) */
    @media (min-width: 992px) {
        .nav-item.dropdown:hover .dropdown-menu {
            display: block;
            margin-top: 0; /* Ngăn khoảng trống khiến menu bị đóng khi di chuyển chuột xuống */
        }
    }
    @media (min-width: 992px) {
        .dropdown-menu {
            display: block;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            margin-top: 10px; /* Tạo khoảng cách ban đầu để tạo hiệu ứng trượt lên */
        }

        .nav-item.dropdown:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            margin-top: 0;
        }
    }
</style>