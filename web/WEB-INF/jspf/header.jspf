<%-- any content can be specified here e.g.: --%>
<%@ page pageEncoding="UTF-8" %>
<%-- Navbar/Header Fragment --%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">

            <c:if test="${not empty sessionScope.ttdn}">
                <span class="text-secondary">
                    <span class="text-danger fw-bold">
                        <c:choose>
                            <c:when test="${sessionScope.ttdn.roleInSystem == 1}">Admin</c:when>
                            <c:when test="${sessionScope.ttdn.roleInSystem == 2}">Manager</c:when>
                            <c:when test="${sessionScope.ttdn.roleInSystem == 3}">Staff</c:when>
                            <c:otherwise>User</c:otherwise>
                        </c:choose>
                    </span> 
                    - ${sessionScope.ttdn.lastName} ${sessionScope.ttdn.firstName}
                </span>
            </c:if>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active bg-secondary bg-opacity-10 px-3" href="index.jsp">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="product?action=view_product" style="font-weight: bold">View products</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Accounts</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="main?action=listAccount">List Acc</a></li> <%-- Đã sửa --%>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Categories</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="main?action=listCategory">List Categories</a></li> <%-- Đã sửa --%>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Products</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="main?action=listProduct">All Products</a></li> <%-- Đã sửa --%>
                    </ul>
                </li> F

            </ul>

            <div class="d-flex gap-2">
                <a href="login" class="btn btn-outline-primary btn-sm d-flex align-items-center text-decoration-none">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                </a>

                <a href="main?action=logout" class="btn btn-outline-danger btn-sm d-flex align-items-center text-decoration-none">
                    <i class="bi bi-box-arrow-left me-1"></i> Logout
                </a>
            </div>
        </div>
    </div>
</nav>
